# 鏁版嵁搴撻厤缃?(Database Configuration)
# 鎺ㄨ崘浣跨敤 PostgreSQL锛孲QLite 浠呯敤浜庡紑鍙戞祴璇?
# Use PostgreSQL for production, SQLite for development only

# Option 1: Direct database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/happystock
# DATABASE_URL=sqlite:///happystock.db

# Option 2: Component-based configuration (if DATABASE_URL not set)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=happystock

# Redis閰嶇疆 (Redis Configuration - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SMTP閭欢閰嶇疆 (SMTP Email Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@happystock.com
SMTP_FROM_NAME=蹇箰鑲＄エ

# 搴旂敤閰嶇疆 (Application Configuration)
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# 浠ょ墝鏈夋晥鏈燂紙绉掞級(Token Expiry in seconds)
PASSWORD_RESET_TOKEN_EXPIRY=86400  # 24灏忔椂
EMAIL_VERIFICATION_TOKEN_EXPIRY=172800  # 48灏忔椂

# JWT瀵嗛挜 (鐢熶骇鐜鍔″繀淇敼)
SECRET_KEY=your-secret-key-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 璋冭瘯妯″紡 (Debug Mode)
DEBUG=True

# 鏃ュ織绾у埆 (Logging Level)
LOG_LEVEL=INFO

# Simulation system overrides
SIM_DB_HOST=localhost
SIM_DB_PORT=5432
SIM_DB_USER=postgres
SIM_DB_PASSWORD=your_sim_password_here
SIM_DB_NAME=happystock_sim
SIM_REDIS_URL=redis://localhost:6379/1

