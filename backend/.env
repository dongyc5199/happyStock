# Database configuration (SQLite for virtual market)
DB_TYPE=sqlite
DATABASE_URL=sqlite:///virtual_market.db

# Redis configuration
REDIS_URL=redis://localhost:6379/1

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@happystock.com
SMTP_FROM_NAME=HappyStock
SMTP_USE_TLS=True

# Application configuration
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEBUG=True
PRICE_GENERATION_ENABLED=False

# Token expiry
PASSWORD_RESET_TOKEN_EXPIRY=86400
EMAIL_VERIFICATION_TOKEN_EXPIRY=172800

# Simulation database
SIM_DB_HOST=localhost
SIM_DB_PORT=5432
SIM_DB_USER=postgres
SIM_DB_PASSWORD=postgres
SIM_DB_NAME=happystock_sim
SIM_REDIS_URL=redis://localhost:6379/1

SIM_SLOW_TICK_THRESHOLD_MS=500      # 例：500ms 以上才记慢日志
SIM_SLOW_TICK_LOG=backend/logs/slow_ticks.log

SIM_AUTOPLAY_SESSIONS=["autoplay-demo"]
SIM_AUTOPLAY_INTERVAL_MS=500
SIM_AUTOPLAY_MODE=autoplay
SIM_AUTOPLAY_VERBOSE=true
SIM_AUTOPLAY_BOOTSTRAP_PRICE=100
SIM_AUTOPLAY_BOOTSTRAP_SPREAD=0.4
SIM_AUTOPLAY_BOOTSTRAP_VOLUME=100
SIM_AUTOPLAY_SESSION_PROFILES={"autoplay-demo":{"market_cap":"small"}}
SIM_MARKET_MAKER_ENABLED=false
SIM_AGENTS_ENABLED=true
SIM_TEST_REAL_BOUNDARY=1
